#!/usr/bin/env bash
set -euo pipefail

# Ordinary local/dev checks, not production-approved migration artifacts.
# Approved artifact-only migration builds must use scripts/private-vm-build.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-all}"

run_backend() {
  (
    cd "$ROOT/backend"
    build_dir="$(mktemp -d)"
    trap 'rm -rf "$build_dir"' EXIT
    go build -o "$build_dir/server" ./cmd/server
    go build -o "$build_dir/audio-analyzer" ./cmd/audio-analyzer
    go build -o "$build_dir/local-playback-smoke" ./cmd/local-playback-smoke
  )
}

run_analyzer() {
  docker build \
    --target analyzer-runtime \
    --tag open-music-player-analyzer:local \
    "$ROOT/backend"
}

run_flutter_android_legacy() {
  # Deliberate recovery only. Never select a historical backend by omission.
  : "${OMP_API_BASE_URL:?Set an explicit approved legacy API base}"
  : "${OMP_SOURCE_REF:?Set the legacy recovery source marker}"
  : "${OMP_BUILD_ID:?Set the legacy recovery build marker}"
  node -e 'require(process.argv[1]).validateUrl(process.env.OMP_API_BASE_URL)' \
    "$ROOT/extension/config/endpoints.cjs"
  (
    cd "$ROOT/client"
    flutter pub get
    flutter build apk --debug --no-pub --target-platform android-arm64 \
      --dart-define=OMP_API_BASE_URL="$OMP_API_BASE_URL" \
      --dart-define=OMP_SOURCE_REF="$OMP_SOURCE_REF" \
      --dart-define=OMP_BUILD_ID="$OMP_BUILD_ID"
  )
}

run_client_web() {
  (
    cd "$ROOT/client"
    flutter pub get
    flutter build web --release --no-pub
  )
}

run_extension() {
  (
    cd "$ROOT/extension"
    if [ ! -d node_modules ]; then
      npm ci
    fi
    npm run build
  )
}

case "$TARGET" in
  android-product)
    python3 "$ROOT/scripts/android-product" build "${@:2}"
    ;;
  native-macos)
    python3 "$ROOT/scripts/native-client" macos
    ;;
  native-android)
    python3 "$ROOT/scripts/native-client" android
    ;;
  backend)
    run_backend
    ;;
  analyzer)
    run_analyzer
    ;;
  client)
    # Android now means the Compose product. Flutter shared checks remain separate.
    python3 "$ROOT/scripts/android-product" build "${@:2}"
    ;;
  client-flutter-android-legacy)
    run_flutter_android_legacy
    ;;
  client-macos)
    (
      cd "$ROOT/client"
      flutter pub get
      flutter build macos --release --no-pub
      # Flutter can report success while an incremental Xcode build has retained
      # an outer seal for an older App.framework. The packaged app is the gate.
      /usr/bin/codesign --verify --deep --strict --verbose=2 \
        build/macos/Build/Products/Release/SoundQ.app
    )
    ;;
  client-web)
    run_client_web
    ;;
  extension)
    run_extension
    ;;
  all)
    run_backend
    run_analyzer
    python3 "$ROOT/scripts/android-product" build
    run_client_web
    run_extension
    ;;
  *)
    echo "usage: scripts/build [android-product|native-macos|native-android|backend|analyzer|client|client-macos|client-web|client-flutter-android-legacy|extension|all]" >&2
    exit 2
    ;;
esac
