#!/usr/bin/env bash
set -euo pipefail

# Native Android only. Flutter Android recovery is an explicit build target.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-build}"
APK_PATH="$ROOT/android/app/build/outputs/apk/debug/app-debug.apk"
PACKAGE=com.soundq.android.dev

usage() {
  printf '%s\n' 'usage: scripts/dogfood-android [build|install|logs|all]' \
    'build uses scripts/android-product with explicit OMP_API_BASE_URL, OMP_SOURCE_REF and OMP_BUILD_ID.' \
    'install/all requires ANDROID_SERIAL and OMP_ALLOW_ANDROID_INSTALL=1; never uninstalls or clears data.' \
    'ADB_SERVER_SOCKET is optional. No device is selected by default.' \
    'Flutter Android recovery: scripts/build client-flutter-android-legacy.' >&2
}

require_target() {
  : "${ANDROID_SERIAL:?Set ANDROID_SERIAL explicitly; default device selection is forbidden}"
  if [ "${OMP_ALLOW_ANDROID_INSTALL:-}" != 1 ]; then
    printf '%s\n' 'Set OMP_ALLOW_ANDROID_INSTALL=1 only after authorizing this exact target/artifact.' >&2
    exit 2
  fi
}

build_apk() {
  python3 "$ROOT/scripts/android-product" build "${@:1}"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  else
    shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

install_apk() {
  require_target
  : "${ANDROID_HOME:?Set ANDROID_HOME}"
  : "${TMPDIR:?Set an owned canonical TMPDIR}"
  : "${OMP_DOGFOOD_EVIDENCE_DIR:?Set a private OMP_DOGFOOD_EVIDENCE_DIR}"
  local tools="$ANDROID_HOME/build-tools/37.0.0"
  [ -f "$APK_PATH" ] || { printf '%s\n' 'Build the native APK first.' >&2; exit 2; }
  local package
  package="$("$tools/aapt" dump badging "$APK_PATH" | python3 -c 'import re,sys; print(re.search(r"package: name=\x27([^\x27]+)",sys.stdin.read()).group(1))')"
  [ "$package" = "$PACKAGE" ] || { printf '%s\n' 'Refusing unexpected application ID.' >&2; exit 2; }
  mkdir -p "$OMP_DOGFOOD_EVIDENCE_DIR"
  local scope
  scope="$(mktemp -d "$TMPDIR/soundq-native-install.XXXXXX")"
  # Retain evidence on failure. No keyfiles, uninstall, clear-data or downgrade flags.
  adb -s "$ANDROID_SERIAL" devices -l > "$scope/devices.txt"
  adb -s "$ANDROID_SERIAL" get-state > "$scope/state.txt"
  "$tools/apksigner" verify --print-certs "$APK_PATH" > "$scope/candidate-cert.txt"
  local installed
  installed="$(adb -s "$ANDROID_SERIAL" shell pm path "$PACKAGE" | tr -d '\r' | python3 -c 'import sys; p=[x.removeprefix("package:").strip() for x in sys.stdin if x.startswith("package:")]; print(next((x for x in p if x.endswith("/base.apk")),p[0] if len(p)==1 else ""))')"
  if [ -n "$installed" ]; then
    adb -s "$ANDROID_SERIAL" pull "$installed" "$scope/installed-before.apk" > "$scope/pull-before.txt" 2>&1
    "$tools/apksigner" verify --print-certs "$scope/installed-before.apk" > "$scope/installed-cert.txt"
    python3 - "$scope" <<'PY'
from pathlib import Path
import re
import sys
root = Path(sys.argv[1])
def signers(name):
    # Build Tools 37 emits "V2 Signer:"; older tools use "Signer #1".
    pattern = r"(?:Signer #\d+|V[1-4] Signer:) certificate SHA-256 digest: ([0-9a-fA-F]{64})"
    return sorted({match.group(1).lower() for line in (root / name).read_text().splitlines()
                   if (match := re.fullmatch(pattern, line.strip()))})
a, b = signers('candidate-cert.txt'), signers('installed-cert.txt')
if not a or a != b:
    raise SystemExit('Signer mismatch. Preserve the installed app/data; use its compatible signing path. No install performed.')
PY
  fi
  adb -s "$ANDROID_SERIAL" install -r "$APK_PATH" > "$scope/install.txt" 2>&1
  installed="$(adb -s "$ANDROID_SERIAL" shell pm path "$PACKAGE" | tr -d '\r' | python3 -c 'import sys; p=[x.removeprefix("package:").strip() for x in sys.stdin if x.startswith("package:")]; print(next((x for x in p if x.endswith("/base.apk")),p[0] if len(p)==1 else ""))')"
  [ -n "$installed" ] || { printf '%s\n' 'Installed package readback missing.' >&2; exit 1; }
  adb -s "$ANDROID_SERIAL" pull "$installed" "$scope/installed-after.apk" > "$scope/pull-after.txt" 2>&1
  cmp "$APK_PATH" "$scope/installed-after.apk"
  {
    printf '%s\n' '# Native Android install evidence' "Package: $PACKAGE" \
      "APK SHA256: $(sha256_file "$APK_PATH")" "Private receipt directory: $scope" \
      'Exact installed bytes verified. No launch, account migration or playback qualification.'
  } > "$OMP_DOGFOOD_EVIDENCE_DIR/evidence.md"
  printf 'Installed native artifact; private receipt: %s\n' "$OMP_DOGFOOD_EVIDENCE_DIR/evidence.md"
}

case "$TARGET" in
  build)
    shift || true
    build_apk "$@"
    ;;
  install)
    install_apk
    ;;
  logs)
    require_target
    : "${OMP_DOGFOOD_EVIDENCE_DIR:?Set a private OMP_DOGFOOD_EVIDENCE_DIR}"
    mkdir -p "$OMP_DOGFOOD_EVIDENCE_DIR"
    adb -s "$ANDROID_SERIAL" logcat -d -t "${OMP_DOGFOOD_LOG_LINES:-1000}" > "$OMP_DOGFOOD_EVIDENCE_DIR/logcat.txt"
    ;;
  all)
    require_target
    shift
    build_apk "$@"
    install_apk
    ;;
  *) usage; exit 2 ;;
esac
