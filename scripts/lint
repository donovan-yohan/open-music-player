#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-all}"

run_delivery() {
  "$ROOT/scripts/agentic-harness"
  python3 "$ROOT/scripts/test-android-product.py"
  python3 "$ROOT/scripts/test-native-publication.py"
  python3 "$ROOT/scripts/check-native-payload.py"
  "$ROOT/scripts/agentic-cycle" --self-test
  "$ROOT/scripts/release-audit" --self-test
}

run_backend() {
  (
    cd "$ROOT/backend"
    unformatted="$(gofmt -l .)"
    if [ -n "$unformatted" ]; then
      echo "gofmt required:" >&2
      echo "$unformatted" >&2
      exit 1
    fi
    go vet ./...
  )
}

run_analyzer() {
  (
    cache_dir="$(mktemp -d)"
    trap 'rm -rf "$cache_dir"' EXIT
    PYTHONPYCACHEPREFIX="$cache_dir" python3 -m py_compile \
      "$ROOT/backend/cmd/audio-analyzer/audio_mir.py" \
      "$ROOT/backend/cmd/audio-analyzer/audio_mir_test.py"
    python3 "$ROOT/scripts/ci-dependencies-test.py"
    docker compose -f "$ROOT/docker-compose.yml" config --quiet
    docker compose -f "$ROOT/docker-compose.local-low-memory.yml" config --quiet
  )
}

run_stems() {
  (
    cache_dir="$(mktemp -d)"
    trap 'rm -rf "$cache_dir"' EXIT
    PYTHONPYCACHEPREFIX="$cache_dir" python3 -m py_compile \
      "$ROOT/backend/cmd/stems-worker/stems_dsp.py" \
      "$ROOT/backend/cmd/stems-worker/stems_dsp_test.py"
  )
}

run_audio_mir() {
  (
    cd "$ROOT/evals/audio_mir"
    uv run --frozen ruff check src tests
    uv run --frozen ruff format --check src tests
  )
}

run_client() {
  (
    cd "$ROOT/client"
    flutter pub get
    flutter analyze --no-fatal-warnings --no-fatal-infos
    # Gated so an unformatted file cannot land and then reappear as a large
    # incidental diff inside somebody else's feature PR.
    dart format --output=none --set-exit-if-changed lib test
  )
}

run_extension() {
  (
    cd "$ROOT/extension"
    if [ ! -d node_modules ]; then
      npm ci
    fi
    npm run type-check
  )
}

case "$TARGET" in
  design-studio)
    (
      export PYTHONDONTWRITEBYTECODE=1
      work="$(mktemp -d "${TMPDIR:-/tmp}/soundq-studio-lint.XXXXXXXX")"
      trap 'rm -rf "$work"' EXIT
      cd "$ROOT"
      python3 -B -c 'import ast,pathlib; files=sorted(pathlib.Path("design-studio").glob("*.py"))+sorted(pathlib.Path("design-studio/tests").glob("test_*.py")); [ast.parse(p.read_text(),filename=str(p)) for p in files]; print("studio syntax ok")'
      python3 -B design-studio/studio.py catalog generate --output "$work/catalog"
      python3 -B design-studio/studio.py catalog check --output "$work/catalog"
    )
    ;;
  android-product)
    python3 "$ROOT/scripts/android-product" lint "${@:2}"
    ;;
  native)
    python3 "$ROOT/scripts/native-client" test
    ;;
  delivery|harness)
    run_delivery
    ;;
  backend)
    run_backend
    ;;
  analyzer)
    run_analyzer
    ;;
  stems)
    run_stems
    ;;
  audio-mir)
    run_audio_mir
    ;;
  client)
    run_client
    ;;
  extension)
    run_extension
    ;;
  all)
    run_delivery
    run_backend
    run_analyzer
    run_stems
    run_audio_mir
    run_client
    run_extension
    ;;
  *)
    echo "usage: scripts/lint [design-studio|android-product|native|delivery|harness|backend|analyzer|stems|audio-mir|client|extension|all]" >&2
    exit 2
    ;;
esac
