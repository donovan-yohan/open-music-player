#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-all}"

run_delivery() {
  "$ROOT/scripts/agentic-cycle" --self-test
}

run_backend() {
  (
    cd "$ROOT/backend"
    go_test_args=()
    if [ -n "${OMP_POSTGRES_TEST_DSN:-${QA_DATABASE_URL:-${DATABASE_URL:-}}}" ]; then
      # Integration packages truncate shared fixtures; one DSN requires
      # package-serial execution to prevent cross-package deadlocks.
      go_test_args+=(-p 1)
    fi
    if [ -n "${BACKEND_GO_TEST_ARGS:-}" ]; then
      # shellcheck disable=SC2206
      extra_args=(${BACKEND_GO_TEST_ARGS})
      go_test_args+=("${extra_args[@]}")
    fi
    go test "${go_test_args[@]}" ./...
  )
}

run_analyzer() {
  docker build \
    --target analyzer-test \
    --tag open-music-player-analyzer-test:local \
    "$ROOT/backend"
}

run_audio_mir() {
  (
    cd "$ROOT/evals/audio_mir"
    uv run --frozen pytest -q
  )
}

# Fast stem DSP contract stage: numpy + scipy + ffmpeg, no torch and no
# checkpoint. The full stems-runtime image (torch-cpu + demucs + baked weights)
# is deliberately NOT part of the default sweep; build it explicitly with
#   docker build --target stems-runtime backend
run_stems() {
  docker build \
    --target stems-test \
    --tag open-music-player-stems-test:local \
    "$ROOT/backend"
}

run_client() {
  (
    # Exercise the real FFI library in the normal client gate, never a skipped
    # native test or a library left over from another checkout.
    native_build="$(mktemp -d "${TMPDIR:-/tmp}/soundq-client-native.XXXXXXXX")"
    cmake -S "$ROOT/client/native/mix_renderer" -B "$native_build" -DCMAKE_BUILD_TYPE=Debug
    cmake --build "$native_build" -j 2
    ctest --test-dir "$native_build" --output-on-failure
    case "$(uname -s)" in
      Darwin) native_extension=dylib ;;
      Linux) native_extension=so ;;
      *) echo "native client tests require a supported host library path" >&2; exit 1 ;;
    esac
    export SOUNDQ_NATIVE_MIX_LIBRARY="$native_build/libsoundq_mix.$native_extension"
    # This target links actual host/render/core but NO OS platform. Tests can
    # exercise device handoff/failures without ever opening a real audio device.
    cmake -S "$ROOT/client/native/device_host" -B "$native_build/ffi-fake" \
      -DCMAKE_BUILD_TYPE=Debug -DSQ_DEVICE_FFI_FAKE_ONLY=ON
    cmake --build "$native_build/ffi-fake" -j 2
    export SOUNDQ_NATIVE_DEVICE_TEST_LIBRARY="$native_build/ffi-fake/libsoundq_device_ffi_fake.$native_extension"
    cd "$ROOT/client"
    flutter pub get
    python3 test/audio_service_vendor_check.py
    python3 test/android_media_source_check.py
    if [ -n "${FLUTTER_TEST_ARGS:-}" ]; then
      # shellcheck disable=SC2206
      extra_args=(${FLUTTER_TEST_ARGS})
      flutter test "${extra_args[@]}"
    else
      flutter test
    fi
  )
}

run_extension() {
  (
    cd "$ROOT/extension"
    if [ ! -d node_modules ]; then
      npm ci
    fi
    npm run type-check
    npm run test:auth-refresh
    npm run test:brand-assets
  )
}

case "$TARGET" in
  delivery|harness)
    run_delivery
    ;;
  backend)
    run_backend
    ;;
  analyzer)
    run_analyzer
    ;;
  stems)
    run_stems
    ;;
  audio-mir)
    run_audio_mir
    ;;
  client)
    run_client
    ;;
  extension)
    run_extension
    ;;
  all)
    run_delivery
    run_backend
    run_analyzer
    run_stems
    run_audio_mir
    run_client
    run_extension
    ;;
  *)
    echo "usage: scripts/test [delivery|harness|backend|analyzer|stems|audio-mir|client|extension|all]" >&2
    exit 2
    ;;
esac
