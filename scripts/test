#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-all}"

run_delivery() {
  "$ROOT/scripts/agentic-cycle" --self-test
}

run_backend() {
  (
    cd "$ROOT/backend"
    go_test_args=()
    if [ -n "${OMP_POSTGRES_TEST_DSN:-${QA_DATABASE_URL:-${DATABASE_URL:-}}}" ]; then
      # Integration packages truncate shared fixtures; one DSN requires
      # package-serial execution to prevent cross-package deadlocks.
      go_test_args+=(-p 1)
    fi
    if [ -n "${BACKEND_GO_TEST_ARGS:-}" ]; then
      # shellcheck disable=SC2206
      extra_args=(${BACKEND_GO_TEST_ARGS})
      go_test_args+=("${extra_args[@]}")
    fi
    go test "${go_test_args[@]}" ./...
  )
}

run_analyzer() {
  docker build \
    --target analyzer-test \
    --tag open-music-player-analyzer-test:local \
    "$ROOT/backend"
}

run_audio_mir() {
  (
    cd "$ROOT/evals/audio_mir"
    uv run --frozen pytest -q
  )
}

# Fast stem DSP contract stage: numpy + scipy + ffmpeg, no torch and no
# checkpoint. The full stems-runtime image (torch-cpu + demucs + baked weights)
# is deliberately NOT part of the default sweep; build it explicitly with
#   docker build --target stems-runtime backend
run_stems() {
  docker build \
    --target stems-test \
    --tag open-music-player-stems-test:local \
    "$ROOT/backend"
}

prepare_client_native() {
  # Fresh host fixtures for this checkout and runner, never a stale library.
  native_build="$(mktemp -d "${TMPDIR:-/tmp}/soundq-client-native.XXXXXXXX")"
  trap 'rm -rf "$native_build"' EXIT
  cmake -S "$ROOT/client/native/mix_renderer" -B "$native_build" -DCMAKE_BUILD_TYPE=Debug
  cmake --build "$native_build" -j 2
  if [ "${1:-}" != "shard" ]; then
    ctest --test-dir "$native_build" --output-on-failure
  fi
  case "$(uname -s)" in
    Darwin) native_extension=dylib ;;
    Linux) native_extension=so ;;
    *) echo "native client tests require a supported host library path" >&2; exit 1 ;;
  esac
  export SOUNDQ_NATIVE_MIX_LIBRARY="$native_build/libsoundq_mix.$native_extension"
  # Actual host/render/core, no OS audio platform or device access.
  local -a configure_fake=(cmake -S "$ROOT/client/native/device_host" -B "$native_build/ffi-fake"
    -DCMAKE_BUILD_TYPE=Debug -DSQ_DEVICE_FFI_FAKE_ONLY=ON)
  if [ "${1:-}" = "shard" ]; then
    # Only configuration overlaps; both producers must settle before the
    # fake-device build or any Flutter test can consume the host fixtures.
    local status=0
    native_ctest_pid=
    trap 'if [ -n "$native_ctest_pid" ]; then kill "$native_ctest_pid" 2>/dev/null || :; wait "$native_ctest_pid" || :; fi; rm -rf "$native_build"' EXIT
    ctest --test-dir "$native_build" --output-on-failure &
    native_ctest_pid=$!
    "${configure_fake[@]}" || status=$?
    wait "$native_ctest_pid" || status=$?
    native_ctest_pid=
    [ "$status" = 0 ] || return "$status"
  else
    "${configure_fake[@]}"
  fi
  cmake --build "$native_build/ffi-fake" -j 2
  export SOUNDQ_NATIVE_DEVICE_TEST_LIBRARY="$native_build/ffi-fake/libsoundq_device_ffi_fake.$native_extension"
  test -s "$SOUNDQ_NATIVE_MIX_LIBRARY"
  test -s "$SOUNDQ_NATIVE_DEVICE_TEST_LIBRARY"
}

check_client_sources() {
  python3 test/audio_service_vendor_check.py
  python3 -B test/just_audio_vendor_check.py
  python3 test/android_media_source_check.py
}

run_client() {
  (
    prepare_client_native
    cd "$ROOT/client"
    flutter pub get
    check_client_sources
    if [ -n "${FLUTTER_TEST_ARGS:-}" ]; then
      # shellcheck disable=SC2206
      extra_args=(${FLUTTER_TEST_ARGS})
      flutter test "${extra_args[@]}"
    else
      flutter test
    fi
  )
}

run_client_shard() {
  (
    prepare_client_native shard
    cd "$ROOT/client"
    check_client_sources
    python3 -I -B "$ROOT/scripts/ci_flutter.py" shard "$@"
  )
}

run_extension() {
  (
    cd "$ROOT/extension"
    if [ ! -d node_modules ]; then
      npm ci
    fi
    npm run type-check
    npm run test:auth-refresh
    npm run test:endpoints
    npm run test:brand-assets
  )
}

case "$TARGET" in
  design-studio)
    (
      export PYTHONDONTWRITEBYTECODE=1
      work="$(mktemp -d "${TMPDIR:-/tmp}/soundq-studio-test.XXXXXXXX")"
      trap 'rm -rf "$work"' EXIT
      cd "$ROOT"
      python3 -B -m unittest discover -s design-studio/tests -v
      python3 -B design-studio/harness.py --output "$work/harness"
      "$ROOT/scripts/lint" design-studio
    )
    ;;
  android-product)
    python3 "$ROOT/scripts/test-android-product.py"
    python3 "$ROOT/scripts/android-product" test "${@:2}"
    ;;
  private-vm)
    node --test "$ROOT/scripts/test-private-vm.cjs"
    ;;
  native)
    python3 "$ROOT/scripts/native-client" test
    ;;
  delivery|harness)
    run_delivery
    ;;
  backend)
    run_backend
    ;;
  analyzer)
    run_analyzer
    ;;
  stems)
    run_stems
    ;;
  audio-mir)
    run_audio_mir
    ;;
  client)
    run_client
    ;;
  client-shard)
    run_client_shard "${@:2}"
    ;;
  extension)
    run_extension
    ;;
  all)
    run_delivery
    node --test "$ROOT/scripts/test-private-vm.cjs"
    run_backend
    run_analyzer
    run_stems
    run_audio_mir
    run_client
    run_extension
    ;;
  *)
    echo "usage: scripts/test [design-studio|android-product|native|private-vm|delivery|harness|backend|analyzer|stems|audio-mir|client|client-shard INDEX OUTPUT|extension|all]" >&2
    exit 2
    ;;
esac
