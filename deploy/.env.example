# Host-specific deploy config for the local/dogfood stack.
# Copy to deploy/.env (gitignored) and fill in per host.
# Consumed by scripts/deploy.sh via `docker compose --env-file deploy/.env`.
# Every value below is also the compose default (${VAR:-default}); override per host.

# Stable compose project name. Pin this so the stack is always targetable and its
# named volumes are reused across rebuilds (never launch from a throwaway worktree).
COMPOSE_PROJECT_NAME=omp

# Host port the API is published on.
SERVER_PORT=8080

# Postgres (also seeds the DB container on first run).
POSTGRES_USER=omp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openmusicplayer

# Redis-backed queue/downloads. Requires the redis service (downloads profile) running.
REDIS_ENABLED=true
WORKER_COUNT=1

# MinIO. MINIO_PUBLIC_ENDPOINT is the URL clients use to stream audio + cover art,
# so it MUST be reachable from the client device — not localhost.
#   - phone/other devices over Tailscale: http://<host-tailscale-ip>:9000
#   - same-LAN only:                       http://<host-lan-ip>:9000
#   - desktop/web on the host:             http://localhost:9000
MINIO_PORT=9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=audio-files

# On-demand stem separation (DJ stem panel / deck). Off by default.
#
# Turning it on requires ALL of:
#   1. STEMS_ENABLED=true here
#   2. the stems compose profile started:
#        scripts/local-low-memory.sh start-stems
#      (or `docker compose --profile stems up -d --build stems`)
#   3. Redis running — the stems queue class requires it, so REDIS_ENABLED=true
#      above plus the downloads profile.
# With STEMS_ENABLED=false the backend logs that separation is disabled and the
# stems API routes answer 503; nothing else in the library is affected.
#
# First build of the stems runtime downloads torch-cpu, demucs, and a pinned
# checkpoint (multi-GB) and is not built by CI. Expect a long first deploy.
STEMS_ENABLED=false

# Shared secret between the backend and the stems worker. Empty means no auth,
# which is only acceptable because the worker is not published outside the
# compose network. Set it on any host where that stops being true.
STEMS_AUTH_TOKEN=

# Workers consuming stems:queue. Hard-capped at 2 by the backend: demucs peaks
# around 2.3 GB RSS, and a second concurrent separation makes both runs slower
# rather than finishing sooner.
STEMS_CONCURRENCY=1

# Reject-when-full backlog bound. Separation is minutes per track, so a deeper
# queue only promises hours of work the host cannot honor; the API answers 429
# once it is full.
STEMS_QUEUE_MAX_DEPTH=32

# Per-separation HTTP budget in milliseconds (default 30 minutes). htdemucs runs
# at roughly realtime on a CPU host, so a long track legitimately occupies this.
STEMS_TIMEOUT_MS=1800000

# JWT signing secret. Changing it invalidates all existing client sessions.
JWT_SECRET=change-me-in-production
